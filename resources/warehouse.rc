#pragma code_page(65001)

#include <windows.h>
#include <commctrl.h>

#include "resource.h"

IDI_APP ICON "warehouse.ico"

IDR_MAIN_MENU MENU
BEGIN
    POPUP "Файл"
    BEGIN
        MENUITEM "Настройки подключения...", ID_FILE_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "Выход", ID_FILE_EXIT
    END
    POPUP "Справка"
    BEGIN
        MENUITEM "О программе", ID_HELP_ABOUT
    END
END

IDD_CONNECTION DIALOGEX 0, 0, 280, 196
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Подключение к PostgreSQL"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Хост:", -1, 12, 14, 60, 10
    EDITTEXT IDC_DB_HOST, 90, 12, 176, 14, ES_AUTOHSCROLL
    LTEXT "Порт:", -1, 12, 36, 60, 10
    EDITTEXT IDC_DB_PORT, 90, 34, 50, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "База данных:", -1, 12, 58, 70, 10
    EDITTEXT IDC_DB_NAME, 90, 56, 176, 14, ES_AUTOHSCROLL
    LTEXT "Пользователь:", -1, 12, 80, 70, 10
    EDITTEXT IDC_DB_USER, 90, 78, 176, 14, ES_AUTOHSCROLL
    LTEXT "Пароль:", -1, 12, 102, 60, 10
    EDITTEXT IDC_DB_PASSWORD, 90, 100, 176, 14, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "SSL-режим:", -1, 12, 124, 70, 10
    COMBOBOX IDC_DB_SSLMODE, 90, 122, 176, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_DB_STATUS, 12, 148, 256, 20, SS_LEFT
    PUSHBUTTON "Проверить", IDC_DB_TEST, 12, 172, 70, 16
    DEFPUSHBUTTON "Подключиться", IDOK, 118, 172, 76, 16
    PUSHBUTTON "Отмена", IDCANCEL, 200, 172, 66, 16
END

IDD_PRODUCT DIALOGEX 0, 0, 300, 240
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Новый товар"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Артикул:", -1, 12, 14, 70, 10
    EDITTEXT IDC_PROD_SKU, 110, 12, 176, 14, ES_AUTOHSCROLL
    LTEXT "Название:", -1, 12, 36, 70, 10
    EDITTEXT IDC_PROD_NAME, 110, 34, 176, 14, ES_AUTOHSCROLL
    LTEXT "Категория:", -1, 12, 58, 70, 10
    COMBOBOX IDC_PROD_CATEGORY, 110, 56, 176, 100, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT "Единица:", -1, 12, 80, 70, 10
    EDITTEXT IDC_PROD_UNIT, 110, 78, 70, 14, ES_AUTOHSCROLL
    LTEXT "Цена продажи, Br:", -1, 12, 102, 90, 10
    EDITTEXT IDC_PROD_PRICE, 110, 100, 176, 14, ES_AUTOHSCROLL
    LTEXT "НДС, %:", -1, 12, 124, 70, 10
    EDITTEXT IDC_PROD_TAX, 110, 122, 70, 14, ES_AUTOHSCROLL
    LTEXT "Срок хранения, дней:", -1, 12, 146, 100, 10
    EDITTEXT IDC_PROD_SHELF, 110, 144, 70, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "Мин. остаток:", -1, 12, 168, 80, 10
    EDITTEXT IDC_PROD_MIN, 110, 166, 70, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "Категорию можно ввести вручную — она будет создана автоматически.",
          -1, 12, 194, 276, 20, SS_LEFT
    DEFPUSHBUTTON "Сохранить", IDOK, 132, 216, 72, 16
    PUSHBUTTON "Отмена", IDCANCEL, 212, 216, 72, 16
END

IDD_SUPPLY DIALOGEX 0, 0, 330, 266
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Поступление товара"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Поставщик:", -1, 12, 14, 70, 10
    COMBOBOX IDC_SUP_SUPPLIER, 120, 12, 196, 100, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT "Накладная:", -1, 12, 36, 70, 10
    EDITTEXT IDC_SUP_INVOICE, 120, 34, 196, 14, ES_AUTOHSCROLL
    LTEXT "Товар:", -1, 12, 58, 70, 10
    COMBOBOX IDC_SUP_PRODUCT, 120, 56, 196, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Количество:", -1, 12, 80, 70, 10
    EDITTEXT IDC_SUP_QTY, 120, 78, 70, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "Цена закупки, Br:", -1, 12, 102, 90, 10
    EDITTEXT IDC_SUP_COST, 120, 100, 70, 14, ES_AUTOHSCROLL
    LTEXT "Срок годности:", -1, 12, 124, 80, 10
    CONTROL "", IDC_SUP_EXPIRY, "SysDateTimePick32", DTS_SHORTDATEFORMAT | WS_TABSTOP,
            120, 122, 90, 14
    LTEXT "Дата поступления:", -1, 12, 146, 90, 10
    CONTROL "", IDC_SUP_DATE, "SysDateTimePick32", DTS_SHORTDATEFORMAT | WS_TABSTOP,
            120, 144, 90, 14
    LTEXT "Примечание:", -1, 12, 168, 70, 10
    EDITTEXT IDC_SUP_NOTE, 120, 166, 196, 14, ES_AUTOHSCROLL
    LTEXT "", IDC_SUP_INFO, 12, 188, 304, 24, SS_LEFT
    DEFPUSHBUTTON "Оформить", IDOK, 162, 240, 72, 16
    PUSHBUTTON "Отмена", IDCANCEL, 242, 240, 72, 16
END

IDD_SALE DIALOGEX 0, 0, 300, 190
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Продажа товара"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Товар:", -1, 12, 14, 60, 10
    COMBOBOX IDC_SALE_PRODUCT, 110, 12, 176, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Количество:", -1, 12, 38, 70, 10
    EDITTEXT IDC_SALE_QTY, 110, 36, 70, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "Цена продажи, Br:", -1, 12, 62, 90, 10
    EDITTEXT IDC_SALE_PRICE, 110, 60, 70, 14, ES_AUTOHSCROLL
    LTEXT "", IDC_SALE_INFO, 12, 86, 276, 46, SS_LEFT
    DEFPUSHBUTTON "Продать", IDOK, 132, 162, 72, 16
    PUSHBUTTON "Отмена", IDCANCEL, 212, 162, 72, 16
END

IDD_WRITEOFF DIALOGEX 0, 0, 320, 218
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Списание товара"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Товар:", -1, 12, 14, 60, 10
    COMBOBOX IDC_WO_PRODUCT, 110, 12, 196, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Количество:", -1, 12, 38, 70, 10
    EDITTEXT IDC_WO_QTY, 110, 36, 70, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "Причина:", -1, 12, 62, 60, 10
    COMBOBOX IDC_WO_REASON, 110, 60, 196, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Комментарий:", -1, 12, 86, 70, 10
    EDITTEXT IDC_WO_COMMENT, 110, 84, 196, 40, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "", IDC_WO_INFO, 12, 130, 296, 32, SS_LEFT
    DEFPUSHBUTTON "Списать", IDOK, 152, 190, 72, 16
    PUSHBUTTON "Отмена", IDCANCEL, 232, 190, 72, 16
END
